{
  "name": "Hospitality Alt-Data Dashboard",
  "install": "curl -LsSf https://astral.sh/uv/install.sh | sh\n$HOME/.local/bin/uv sync --all-extras --dev",
  "terminals": [
    {
      "name": "streamlit",
      "command": "$HOME/.local/bin/uv run streamlit run app.py --server.port 8501 --server.address 0.0.0.0 --server.headless true"
    }
  ]
}
